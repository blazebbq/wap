# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wap_dev"

# Auth.js
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email (for magic-link auth) - use a real SMTP provider in production
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="yourpassword"
EMAIL_FROM="noreply@yourbrand.co.uk"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Platform hostname
PLATFORM_HOST="app.yourbrand.co.uk"
BASE_DOMAIN="yourbrand.co.uk"

# Impersonation secret (for signing impersonation tokens)
IMPERSONATION_SECRET="change-me-impersonation-secret"
